--- a/.github/workflows/ci.yml	1970-01-01 00:00:00.000000000 +0000
+++ b/.github/workflows/ci.yml	2026-09-04 03:00:49.064600615 +0000
@@ -0,0 +1,69 @@
+name: CI
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+
+jobs:
+  test:
+    runs-on: ubuntu-latest
+
+    # Sobe um MySQL real para o job, para que os testes de integração que
+    # dependem de banco (autenticação local, aprovação de orçamento, etc.)
+    # rodem de verdade em vez de serem silenciosamente pulados/reprovados
+    # por "Banco de dados indisponível".
+    services:
+      mysql:
+        image: mysql:8.4
+        env:
+          MYSQL_ROOT_PASSWORD: root
+          MYSQL_DATABASE: luminno_ci
+        ports:
+          - 3306:3306
+        options: >-
+          --health-cmd="mysqladmin ping -proot"
+          --health-interval=5s
+          --health-timeout=5s
+          --health-retries=10
+
+    env:
+      DATABASE_URL: mysql://root:root@127.0.0.1:3306/luminno_ci
+      JWT_SECRET: ci-test-secret-not-for-production
+
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: pnpm/action-setup@v4
+        with:
+          version: 11.24.0
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: pnpm
+
+      - name: Instalar dependências
+        run: pnpm install --frozen-lockfile
+
+      - name: Aguardar o MySQL aceitar conexões
+        run: |
+          for i in $(seq 1 30); do
+            mysqladmin ping -h127.0.0.1 -uroot -proot --silent && break
+            echo "Aguardando MySQL... ($i)"
+            sleep 2
+          done
+
+      - name: Aplicar migrações do banco
+        run: pnpm db:push
+
+      - name: Checagem de tipos
+        run: pnpm check
+
+      - name: Testes
+        run: pnpm test
+
+      - name: Build de produção
+        run: |
+          pnpm exec vite build
+          pnpm exec esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist
